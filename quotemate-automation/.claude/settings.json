{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" pre-bash || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" pre-edit || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" post-edit || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" post-bash || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" route || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" session-restore || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/auto-memory-hook.mjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/auto-memory-hook.mjs\"; [ -f \"$h\" ] && node \"$h\" import || true",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" session-end || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/auto-memory-hook.mjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/auto-memory-hook.mjs\"; [ -f \"$h\" ] && node \"$h\" sync || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" compact-manual || true"
          },
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" session-end || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" compact-auto || true"
          },
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" session-end || true",
            "timeout": 6
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" status || true",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" post-task || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] || h=\"$HOME/.claude/helpers/hook-handler.cjs\"; [ -f \"$h\" ] && node \"$h\" notify || true",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node -e \"const fs=require('fs'),p=require('path');const d=process.env.CLAUDE_PROJECT_DIR||'.';const f=p.join(d,'.claude/helpers/statusline.cjs');const h=p.join(process.env.USERPROFILE||process.env.HOME||'.', '.claude/helpers/statusline.cjs');require(fs.existsSync(f)?f:h);\""
  },
  "permissions": {
    "allow": [
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  },
  "claudeFlow": {
    "version": "3.0.0",
    "enabled": true,
    "platform": {
      "os": "windows",
      "arch": "x64",
      "shell": "powershell"
    },
    "modelPreferences": {
      "default": "claude-opus-4-8",
      "routing": "claude-haiku-4-5-20251001"
    },
    "agentTeams": {
      "enabled": true,
      "teammateMode": "auto",
      "taskListEnabled": true,
      "mailboxEnabled": true,
      "coordination": {
        "autoAssignOnIdle": true,
        "trainPatternsOnComplete": true,
        "notifyLeadOnComplete": true,
        "sharedMemoryNamespace": "agent-teams"
      },
      "hooks": {
        "teammateIdle": {
          "enabled": true,
          "autoAssign": true,
          "checkTaskList": true
        },
        "taskCompleted": {
          "enabled": true,
          "trainPatterns": true,
          "notifyLead": true
        }
      }
    },
    "swarm": {
      "topology": "hierarchical-mesh",
      "maxAgents": 15
    },
    "memory": {
      "backend": "hybrid",
      "enableHNSW": true,
      "learningBridge": {
        "enabled": true
      },
      "memoryGraph": {
        "enabled": true
      },
      "agentScopes": {
        "enabled": true
      }
    },
    "neural": {
      "enabled": true
    },
    "daemon": {
      "autoStart": false,
      "workers": [
        "map",
        "audit",
        "optimize"
      ],
      "schedules": {
        "audit": {
          "interval": "4h",
          "priority": "critical"
        },
        "optimize": {
          "interval": "2h",
          "priority": "high"
        }
      }
    },
    "learning": {
      "enabled": true,
      "autoTrain": true,
      "patterns": [
        "coordination",
        "optimization",
        "prediction"
      ],
      "retention": {
        "shortTerm": "24h",
        "longTerm": "30d"
      }
    },
    "adr": {
      "autoGenerate": true,
      "directory": "/docs/adr",
      "template": "madr"
    },
    "ddd": {
      "trackDomains": true,
      "validateBoundedContexts": true,
      "directory": "/docs/ddd"
    },
    "security": {
      "autoScan": true,
      "scanOnEdit": true,
      "cveCheck": true,
      "threatModel": true
    }
  }
}
